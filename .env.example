# ─────────────────────────────────────────────
#  Pet Licence Factory — Environment Variables
#  Copy this file to .env and fill in your keys.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────

# Database (AWS RDS Postgres — shared instance)
DATABASE_URL=postgresql://plf_admin:PASSWORD@lessoncomplete-db.c9e2648w8z0z.us-east-2.rds.amazonaws.com:5432/petlicencefactory?sslmode=require

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Admin API authentication
ADMIN_PASSWORD_HASH=          # bcrypt hash of admin password (generate with: node -e "console.log(require('bcryptjs').hashSync('your-password',12))")
ADMIN_JWT_SECRET=             # random 64-char hex string (generate with: openssl rand -hex 32)

# EasyPost (shipping labels + tracking)
# Set to your EZTK... test key for dev / EZAK... production key for live.
# The same code works for both — just swap this one env var to go live.
EASYPOST_API_KEY=

# SendGrid (transactional emails)
SENDGRID_API_KEY=SG...
SENDGRID_FROM_EMAIL=orders@yourstore.com
SENDGRID_FROM_NAME=Pet Licence Factory

# Affiliate system
# Per-day visitor-hash salt for click dedup. Falls back to ADMIN_JWT_SECRET if unset.
AFFILIATE_CLICK_SALT=

# ── Creator payouts ────────────────────────────────────────────────
# Tremendous (gift card payouts: Amazon, Visa Prepaid, PayPal cash, etc.)
# Sandbox keys start with TEST_, production keys with PROD_.
# Get one at https://app.tremendous.com → Settings → API & Webhooks.
TREMENDOUS_API_KEY=
# https://testflight.tremendous.com for sandbox, https://www.tremendous.com for prod.
TREMENDOUS_API_BASE=https://testflight.tremendous.com
# Funding source id from Tremendous dashboard (ACH bank or balance source).
TREMENDOUS_FUNDING_SOURCE_ID=
# Optional campaign id to scope which rewards creators can pick.
TREMENDOUS_CAMPAIGN_ID=
# Webhook signing secret (set after creating the webhook endpoint).
TREMENDOUS_WEBHOOK_SECRET=

# Stripe Connect (Express accounts for direct-deposit cash payouts at $25+).
# Reuses STRIPE_SECRET_KEY above. Onboarding return/refresh URLs are where
# Stripe sends the creator after they finish (or abandon) the hosted form.
STRIPE_CONNECT_RETURN_URL=https://petlicensefactory.com/dashboard.html?connect=ok
STRIPE_CONNECT_REFRESH_URL=https://petlicensefactory.com/dashboard.html?connect=refresh
# Separate signing secret for the Connect-events webhook endpoint.
# Configure in Stripe Dashboard → Developers → Webhooks → "Events on
# Connected accounts" → copy signing secret here.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

# Pixels (paid-ad attribution; independent of the affiliate creator system)
# Leave blank to disable. /api/pixels-config exposes these to public/pixels.js.
META_PIXEL_ID=
TIKTOK_PIXEL_ID=
