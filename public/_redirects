# ── Goofy Licenses: canonical domain is goofylicenses.com (plural) ──
# Host-based routing (www + singular goofylicense.com → goofylicenses.com,
# the goofylicenses.com homepage, /pet, /forklift, /clown) lives in
# functions/_middleware.js: Pages ignores domain-based rules in this file.

# ── Goofy line URLs: /<line> rewrites to the shared builder (URL stays) ──
# e.g. goofylicenses.com/goat?src=frat-batch-1 serves public/goofy/index.html.
/goat /goofy/ 200
/goat/* /goofy/:splat 200

